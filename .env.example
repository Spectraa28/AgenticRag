# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""
GROQ_MODEL = "openai/gpt-oss-20b"
GUARDRAIL_MODEL = "openai/gpt-oss-20b"

# Portkey LLM Gateway
PORTKEY_API_KEY = ""
PORTKEY_CONFIG_SLUG = ""

# Qdrant Vector DB Settings. Local mode needs no account or cluster and is
# ideal for a demo; data persists under ./qdrant_data.
QDRANT_MODE = "local"
QDRANT_LOCAL_PATH = "qdrant_data"
QDRANT_API_KEY =""
QDRANT_CLUSTER_ENDPOINT = ""

# === Observability

# Pydantic Logfire Observability
LOGFIRE_TOKEN =  ""

# LANGSMITH 

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""


BACKEND_URL = ""

# API access and browser clients. API_KEY is required when ENVIRONMENT=production.
ENVIRONMENT = "development"
API_KEY = ""
ALLOWED_ORIGINS = "http://localhost:5173,http://localhost:3000"


JUDGE_GROQ = ""

GEMINI_API_KEY = ""
# Conservative local ingestion settings for the Gemini free tier.
GEMINI_EMBED_BATCH_SIZE = "10"
GEMINI_EMBED_BATCH_INTERVAL_SECONDS = "4"

